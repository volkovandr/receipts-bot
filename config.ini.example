[telegram]
bot_token = your_telegram_bot_token_here
allowed_user_ids = comma_separated_list_of_ids_here

[database]
host = localhost
port = 5432
name = receipts_db
user = your_db_user
password = your_db_password

[anthropic]
api_key = your_anthropic_api_key_here
prompt_template = prompt.txt
model = claude-sonnet-4-6
prompt_format = toon
enable_prompt_caching = false

[prometheus]
enabled = true
port = 8000

[receipt_processing]
default_category = Uncategorized

[skew_detection]
# Skew angle threshold in degrees
# Images with skew above this threshold will trigger user warning
threshold = 1.0

# Minimum number of text line contours required for reliable detection
min_contours = 3

# Morphological kernel size for text line detection (width, height)
kernel_width = 50
kernel_height = 2
